---
title: All Accessibility Tips
description: Browse every accessibility tip, pattern, and testing guide published on Accessibility Tips.
layout: layouts/base-home.njk
pagination:
  data: collections.sortedByTitle
  size: 6
  alias: paginatedPosts
  addAllPagesToCollections: true
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}All Accessibility Tips - Page {{ pagination.pageNumber + 1 }}{% else %}All Accessibility Tips{% endif %}"
---

<section class="page-intro">
    <p class="page-intro__eyebrow">Browse</p>
    <h1 class="page-intro__title">{{ title }}</h1>
    <p class="page-intro__description">{{ description }}</p>
</section>

{% for post in paginatedPosts %}
    {% set showDescription = true %}
    {% include 'layouts/components/postCard.njk' %}
{% endfor %}

{% if pagination.pages.length > 1 %}
    {% set totalItems = collections.sortedByTitle.length %}
    {% set startItem = (pagination.pageNumber * pagination.size) + 1 %}
    {% set endItem = startItem + paginatedPosts.length - 1 %}
    {% set prevUrl = pagination.href.previous %}
    {% set nextUrl = pagination.href.next %}
    {% include 'layouts/components/pagination.njk' %}
{% endif %}
