---
title: Accessibility Tips
description: Tips, tricks and tools for building inclusive, accessible web applications.
layout: layouts/base-home.njk
eleventyNavigation:
  key: Home
  title: Home
  order: 1
pagination:
  data: collections.sortedByDate
  size: 6
  alias: paginatedPosts
---

{% if pagination.pageNumber == 0 %}
<div class="hero">
    <h1 class="hero__heading">Best practices of accessibility in front-end development</h1>
    <p class="hero__description">Tips, tricks and tools for building inclusive, accessible web applications.</p>
</div>
{% endif %}

{%- for post in paginatedPosts -%}
    {% set showDescription = true %}
    {% include 'layouts/components/postCard.njk' %}
{%- endfor -%}

{% set totalItems = collections.sortedByTitle.length %}
{% set currentPage = pagination.pageNumber %}
{% set pageSize = pagination.size %}
{% set startItem = (currentPage * pageSize) + 1 %}
{% set endItem = startItem + paginatedPosts.length - 1 %}

<nav class="pagination" aria-label="Pagination">
    <div class="pagination__inner">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}" class="pagination__link pagination__link--prev" aria-label="Go to previous page">
                <span class="pagination__chevron" aria-hidden="true">&lsaquo;</span>
                Prev
            </a>
        {% else %}
            <span class="pagination__link pagination__link--prev pagination__link--disabled" aria-disabled="true">
                <span class="pagination__chevron" aria-hidden="true">&lsaquo;</span>
                Prev
            </span>
        {% endif %}

        <span class="pagination__info">
            Showing <strong>{{ startItem }} - {{ endItem }}</strong> of <strong>{{ totalItems }}</strong>
        </span>

        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}" class="pagination__link pagination__link--next" aria-label="Go to next page">
                Next
                <span class="pagination__chevron" aria-hidden="true">&rsaquo;</span>
            </a>
        {% else %}
            <span class="pagination__link pagination__link--next pagination__link--disabled" aria-disabled="true">
                Next
                <span class="pagination__chevron" aria-hidden="true">&rsaquo;</span>
            </span>
        {% endif %}
    </div>
</nav>
