<!DOCTYPE html>
<html {% if section %}data-current="{{ section }}" {% endif %}lang="en">
    {% include "layouts/components/head.njk" %}
    <body>
        <a href="#main-content" class="skip-link">Skip to main content</a>
        {% include "layouts/components/site-header.njk" %}
        <main id="main-content" class="container" tabindex="-1">
            {% block content %}
                {{ content | safe }}
            {% endblock content %}
        </main>
        <footer>
            <span>&copy; {% year %} <a href="https://vranjan.dev/">Vinay Ranjan</a></span>
            <span>&middot; All rights reserved.</span>
        </footer>
    </body>
</html>
