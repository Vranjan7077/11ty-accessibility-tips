<head>
    <script>
    (function () {
        try {
            var theme = localStorage.getItem('theme');
            if (theme === 'light' || theme === 'dark') {
                document.documentElement.setAttribute('data-theme', theme);
            }
        } catch (e) {}
    })();
    </script>
    {% set renderTitle = renderData.title or title or metadata.title %}
    {% set renderDescription = renderData.description or description or metadata.description %}
    {% set renderKeywords = renderData.keywords or keywords or metadata.keywords %}
    {% set isPost = layout == 'layouts/partials/post.njk' %}

    <title>{% if isPost %}{{ renderTitle }} - {{ metadata.title }}{% else %}{{ renderTitle }}{% endif %}</title>

    {% include 'layouts/components/meta.njk' %}

    {% if isPost %}
    {% set schemaType = 'Article' if type == 'resource' else 'TechArticle' %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "{{ schemaType }}",
        "headline": "{{ renderTitle }}",
        "description": "{{ renderDescription | truncate(160) }}",
        "datePublished": "{{ page.date | htmlDateString }}",
        "dateModified": "{{ (lastUpdated or page.date) | htmlDateString }}",
        {% if level %}"proficiencyLevel": "{{ level | capitalize }}",{% endif %}
        "author": {
            "@type": "Person",
            "name": "{{ metadata.author.name }}",
            "url": "https://vranjan.dev/"
        },
        "publisher": {
            "@type": "Organization",
            "name": "{{ metadata.title }}",
            "url": "{{ metadata.url }}"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ metadata.url }}{{ page.url }}"
        },
        "url": "{{ metadata.url }}{{ page.url }}"
    }
    </script>
    {% else %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ metadata.title }}",
        "description": "{{ renderDescription }}",
        "url": "{{ metadata.url }}",
        "author": {
            "@type": "Person",
            "name": "{{ metadata.author.name }}",
            "url": "https://vranjan.dev/"
        }
    }
    </script>
    {% endif %}

    {% block head %}{% endblock %}
</head>
