<div class="theme-toggle" role="radiogroup" aria-label="Theme">
    <button type="button" class="theme-toggle__option" data-theme-value="system" role="radio" aria-checked="true" tabindex="0">
        <svg class="theme-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M8 20h8M12 16v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="visually-hidden">System theme</span>
    </button>
    <button type="button" class="theme-toggle__option" data-theme-value="light" role="radio" aria-checked="false" tabindex="-1">
        <svg class="theme-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="visually-hidden">Light theme</span>
    </button>
    <button type="button" class="theme-toggle__option" data-theme-value="dark" role="radio" aria-checked="false" tabindex="-1">
        <svg class="theme-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <span class="visually-hidden">Dark theme</span>
    </button>
</div>
<script src="{{ '/assets/js/theme.js' | url }}" defer></script>
