<meta charset="utf-8">
<meta name="author" content="{{ metadata.author.name }}"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1a202c" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">

{%- set pageDescription = description or renderDescription or metadata.description -%}
{%- set pageTitle = renderTitle or title or metadata.title -%}
{%- set pageUrl = metadata.url + page.url -%}
{%- set isPost = layout == 'layouts/partials/post.njk' -%}

<meta name="description" content="{{ pageDescription | truncate(160) }}">
<meta name="keywords" content="{{ renderKeywords or metadata.keywords | join(', ') }}">
<meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow{% endif %}">

<meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription | truncate(200) }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:site_name" content="{{ metadata.title }}">
<meta property="og:locale" content="{{ metadata.locale }}">
{% if isPost %}
<meta property="article:author" content="{{ metadata.author.name }}">
{% if topicsList and topicsList.length %}<meta property="article:section" content="{{ topicsList[0] }}">{% endif %}
{% endif %}

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription | truncate(200) }}">
<meta name="twitter:site" content="@_vranjan">
<meta name="twitter:creator" content="@_vranjan">

<meta name="msapplication-TileColor" content="#1a202c">
<meta name="msapplication-TileImage" content="/assets/favicons/ms-icon-144x144.png">
<meta name="msapplication-config" content="/assets/favicons/browserconfig.xml">