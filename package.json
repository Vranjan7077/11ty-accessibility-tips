{
    "name": "11ty-accessibility-tips",
    "version": "2.0.0",
    "private": true,
    "description": "Best practices, tips, and code examples for building inclusive, accessible web applications - covering WCAG, ARIA, HTML semantics, and assistive technology testing.",
    "keywords": [
        "accessibility",
        "a11y",
        "wcag",
        "aria",
        "screen-reader",
        "keyboard-navigation",
        "inclusive-design",
        "eleventy",
        "html",
        "css",
        "javascript"
    ],
    "homepage": "https://accessibilitytips.netlify.app",
    "bugs": {
        "url": "https://github.com/Vranjan7077/11ty-accessibility-tips/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vranjan7077/11ty-accessibility-tips.git"
    },
    "license": "MIT",
    "author": {
        "name": "Vinay Ranjan",
        "url": "https://vranjan.dev/"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
        "npm": "^9.8.0 || ^10.2.0 || >=11.0.0"
    },
    "browserslist": {
        "production": [
            "defaults"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "scripts": {
        "clean": "rimraf public src/css/main.css src/css/vendors",
        "format": "prettier --write \"**/*.{js,scss}\" \"!public\"",
        "watch:sass": "sass --no-source-map --watch src/_includes/sass:src/css",
        "watch:eleventy": "eleventy --serve",
        "build:sass": "sass --no-source-map src/_includes/sass:src/css",
        "build:eleventy": "eleventy",
        "build:css": "postcss src/css/*.css -u autoprefixer cssnano -r --no-map",
        "start": "npm-run-all clean build:sass build:css --parallel watch:*",
        "build": "npm-run-all clean build:sass build:css build:eleventy"
    },
    "dependencies": {
        "@11ty/eleventy": "^3.1.5",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "^2.0.4",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "html-minifier-terser": "^7.2.0",
        "luxon": "^3.7.2",
        "markdown-it": "^14.1.1",
        "markdown-it-anchor": "^9.2.0"
    },
    "devDependencies": {
        "@11ty/eleventy-img": "^7.0.0",
        "autoprefixer": "^10.4.13",
        "cssnano": "^7.1.4",
        "fast-glob": "^3.3.3",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.20",
        "postcss-cli": "^11.0.1",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "sass": "^1.99.0"
    }
}
